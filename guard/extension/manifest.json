{
  "manifest_version": 3,
  "name": "ShortsGuard — Reels & Shorts blocker",
  "version": "1.0.0",
  "description": "Hides YouTube Shorts, Facebook Reels and Instagram Reels. Feeds, DMs and Messenger keep working. No tracking, no network calls.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.fb.com/*",
    "https://fb.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.fb.com/*",
        "https://fb.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["shorts-guard.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ShortsGuard",
    "default_popup": "popup.html"
  },
  "homepage_url": "https://github.com/iamtanzir/DNS-Server-List"
}
